# Gemini, recommended default
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Optional OpenRouter mode for free-tier OpenAI-compatible models
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# AI_MODEL=deepseek/deepseek-chat-v3.1:free

# Optional DeepSeek mode
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# AI_MODEL=deepseek-v4-flash

# Optional fully custom OpenAI-compatible provider
# AI_PROVIDER=custom
# AI_BASE_URL=https://your-provider.example.com/v1
# AI_API_KEY=your_provider_key_here
# AI_MODEL=your-model-id

PORT=5173
